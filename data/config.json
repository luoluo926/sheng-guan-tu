      "keju": 28,
      "difang": 18,
      "jingqing": 15,
      "zhongshu": 17
    },
    "// 各圈层格子浅底色 / 边线色（四圈靠深浅区分）": "",
    "ringFill": {
      "keju": "#fffdf8",
      "difang": "#fdf6e8",
      "jingqing": "#faf0dc",
      "zhongshu": "#fff7e0"
    },
    "ringEdge": {
      "keju": "rgba(192,57,43,0.32)",
      "difang": "rgba(184,148,62,0.42)",
      "jingqing": "rgba(184,148,62,0.34)",
      "zhongshu": "rgba(192,57,43,0.36)"
    },
    "// 美工出图后填路径即可替换内置矢量绘制；留空则用代码画的版本": "",
